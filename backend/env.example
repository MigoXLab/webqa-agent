# Database
# 方式1: 完整连接字符串
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webqa
# 方式2: 分别配置（K8s 推荐，优先级低于 DATABASE_URL）
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=webqa

# Redis
# 方式1: 完整连接字符串
REDIS_URL=redis://localhost:6379/0
# 方式2: 分别配置（K8s 推荐，优先级低于 REDIS_URL）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
PROGRESS_CACHE_TTL=43200  # 进度缓存保留时间（秒），默认 12 小时

# LLM Configuration
LLM_API=openai
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_AVAILABLE_MODELS=gpt-4.1-mini-2025-04-14,gpt-5-mini-2025-08-07,gemini-3-flash-preview
LLM_DEFAULT_MODEL=gpt-5-mini-2025-08-07

# Gen mode (AI 探索) 可用模型，留空则复用 LLM_AVAILABLE_MODELS
LLM_GEN_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview,gpt-5.4
LLM_GEN_DEFAULT_MODEL=gemini-3.1-pro-preview

# Per-model API Key / Base URL（可选，覆盖默认值）
# 命名规则: LLM_API_KEY_<MODEL_NORMALIZED>  /  LLM_BASE_URL_<MODEL_NORMALIZED>
# 其中 MODEL_NORMALIZED = 模型名大写，- 和 . 替换为 _
# 例如 intern-s1-pro → INTERN_S1_PRO
# LLM_API_KEY_INTERN_S1_PRO=sk-xxx
# LLM_BASE_URL_INTERN_S1_PRO=https://chat.intern-ai.org.cn/api/v1

# Execution Control
JOB_TIMEOUT_SECONDS=7200      # 单个 Job 最长执行时间（秒）
MAX_CONCURRENT_JOBS=5         # 系统同时执行的 Job 数量上限
DEFAULT_WORKERS=1             # 单个 Job 内的默认并行 Case 数
MAX_WORKERS=5                 # 单个 Job 内的最大并行 Case 数
WEBQA_CASE_TIMEOUT=2400       # 单个 Case 超时（秒），默认 40 分钟

# Execution Mode: "local" / "docker" / "kubernetes"
# - local: 启动子进程运行 Agent（本地开发）
# - docker: 创建 Docker 容器运行 Agent（Docker Compose）
# - kubernetes: 创建 K8s Job 运行 Agent（K8s 集群）
EXECUTION_MODE=local

# Backend Callback URL (供 Agent Job 回调使用)
BACKEND_CALLBACK_URL=http://localhost:8000

# Docker Mode Configuration (仅 EXECUTION_MODE=docker 时生效)
# DOCKER_AGENT_IMAGE=webqa-agent:latest
# DOCKER_NETWORK=webqa-network
# DOCKER_SHARED_VOLUME=webqa-shared-data

# Notification Webhook (定时任务执行完成后的通知地址，留空则不通知)
# DEFAULT_FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_TIMEOUT_SECONDS=10

# Shared Storage Configuration (Docker Compose / K8s 使用)
# 本地开发留空则使用项目内 data 目录
# SHARED_STORAGE_PATH=/shared
# SHARED_REPORTS_DIR=reports
# SHARED_LOGS_DIR=logs

# Kubernetes Job Resource Limits (仅 EXECUTION_MODE=kubernetes 时生效)
# K8S_JOB_CPU_REQUEST=0.5
# K8S_JOB_CPU_LIMIT=2
# K8S_JOB_MEMORY_REQUEST=1Gi
# K8S_JOB_MEMORY_LIMIT=4Gi
