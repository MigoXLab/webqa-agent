# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webqa

# Redis (进度缓存，本地和集群统一使用)
REDIS_URL=redis://localhost:6379/0
PROGRESS_CACHE_TTL=36000  # 进度缓存保留时间（秒），默认 10 小时
REDIS_MAX_CONNECTIONS=50  # Redis 连接池最大连接数
PROGRESS_MAX_LOGS=1000    # 进度缓存中最多保留的日志条数（避免 Redis value 过大）

# LLM Configuration
LLM_API=openai
LLM_API_KEY=sk-xxx
LLM_BASE_URL: "http://35.220.164.252:3888/v1"
LLM_AVAILABLE_MODELS: "gpt-5-mini-2025-08-07,gpt-4.1-mini-2025-04-14,qwen3-vl-plus,doubao-seed-1-6-251015,gemini-3-flash-preview"
LLM_DEFAULT_MODEL: "gpt-5-mini-2025-08-07"

# Execution Control
JOB_TIMEOUT_SECONDS=7200      # 单个 Job 最长执行时间（秒）
MAX_CONCURRENT_JOBS=5         # 系统同时执行的 Job 数量上限
DEFAULT_WORKERS=1             # 单个 Job 内的默认并行 Case 数
MAX_WORKERS=5                 # 单个 Job 内的最大并行 Case 数

# Execution Mode: "local" / "docker" / "kubernetes"
# - local: 启动子进程运行 Agent（本地开发）
# - kubernetes: 创建 K8s Job 运行 Agent（K8s 集群）
EXECUTION_MODE=local

# Feishu Webhook (定时任务执行完成后的默认飞书通知地址)
DEFAULT_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/ea37e263-8e8b-4b9a-b98d-cd0b6ad4f4fc
FEISHU_WEBHOOK_TIMEOUT_SECONDS=10

# Shared Storage Configuration (used for Docker Compose and K8s)
# - Reports and logs are written here
# - Backend reads from here to upload to OSS
SHARED_STORAGE_PATH=/shared
SHARED_REPORTS_DIR=reports
SHARED_LOGS_DIR=logs
