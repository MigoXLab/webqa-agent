FROM acr-openxlab-prod-registry-vpc.cn-shanghai.cr.aliyuncs.com/public/python:3.11-slim

WORKDIR /app

# 后端只需要 backend/ 代码和自己的依赖
# webqa_agent/ 由 Agent 镜像 (Dockerfile) 独立构建，后端不需要
COPY backend/ /app/backend/

# 升级 pip 并配置清华镜像源，然后安装依赖
RUN pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir -r /app/backend/requirements.txt

# 设置 PYTHONPATH 以便正确导入 backend 和 webqa_agent 模块
ENV PYTHONPATH=/app:/app/backend

# 设置工作目录为 backend 目录
WORKDIR /app/backend

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
